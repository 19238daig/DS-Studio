# Copy to .env and provide local credentials; never commit .env.
API_KEY=
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Project configuration; translate to provider parameters in the model adapter.
MAIN_MODEL=qwen3.8-flash
ANALYST_MODEL=qwen3.7-plus-2026-05-26
REPORT_MODEL=qwen3.7-plus-2026-05-26
MAIN_ENABLE_THINKING=false
ANALYST_ENABLE_THINKING=true
REPORT_ENABLE_THINKING=false
ANALYST_THINKING_BUDGET=4096
# 各角色采样温度；部分托管模型（如 kimi-k3）不接受 temperature 参数，设为 off 则完全不发送
MAIN_TEMPERATURE=0.1
ANALYST_TEMPERATURE=0.1
REPORT_TEMPERATURE=0.1
MAIN_MAX_OUTPUT_TOKENS=4096
ANALYST_MAX_OUTPUT_TOKENS=8192
REPORT_MAX_OUTPUT_TOKENS=8192
# Shared main/specialist tool budget; bounded retries remain independent.
MAX_TOOL_CALLS=256
MAX_AGENT_STEPS=1024
TASK_TIMEOUT_SECONDS=3600
# 1 GiB per file and per upload batch / selected task inputs (bytes).
MAX_UPLOAD_BYTES=1073741824
MAX_TASK_INPUT_BYTES=1073741824
# PostgreSQL 18: management credentials are used only by scripts/db_manage.py.
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agent_conn
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=
DB_USER=ds_project_reader
DB_PASSWORD=
DB_RESTRICTED_USER=ds_project_seller_reader
DB_RESTRICTED_PASSWORD=
DB_STATEMENT_TIMEOUT_SECONDS=120
DB_CONNECT_TIMEOUT_SECONDS=5
DB_MAX_RESULT_BYTES=1073741824
DB_MAX_RESULT_ROWS=1000000
DB_FETCH_ROWS=2000
DB_DATASET_DIR=./datasets/olist
# Optional legacy SQL-reference location; not used for automatic SQL execution.
DB_SOURCE_SQL_DIR=./local/database

# —— 运行调优（均有默认值，可选） ——
# MODEL_TIMEOUT_SECONDS=120          # 单次模型调用超时
# TASK_TIMEOUT_SECONDS=3600          # 单任务总时长上限
# MAX_TOOL_CALLS=256                 # 工具调用预算
# MAX_AGENT_STEPS=1024               # Agent 步数上限
# MODEL_STREAMING_ENABLED=true       # 模型流式返回
# SSE_STREAM_ENABLED=true            # SSE 进度流
# CONTEXT_POLICY=enforce             # 上下文裁剪：off/shadow/enforce
# CONTEXT_SUMMARY_TRIGGER_TOKENS=24000
# WORKFLOW_FAST_PATHS=true           # 单指标/报告快速路径
# WORKER_CONCURRENCY=1               # 并发任务数（1-2）
# DOCKER_IMAGE=ds-analysis:local     # 分析沙箱镜像
# SANDBOX_TIMEOUT_SECONDS=120        # 沙箱内脚本超时
# MAX_UPLOAD_BYTES=1073741824        # 单文件上限（1GiB）
# MAX_FILES_PER_TASK=10              # 每次提问最多文件数
